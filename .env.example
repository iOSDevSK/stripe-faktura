# ─────────────────────────────────────────────────────────────────────────
# stripe-faktura — example configuration
# Copy to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────────────────

# === Stripe ===
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# === Supplier (your company, the invoice issuer) ===
SUPPLIER_NAME=BELNEM s.r.o.
SUPPLIER_STREET=Beckovská 5
SUPPLIER_CITY=Bratislava
SUPPLIER_ZIP=82104
SUPPLIER_COUNTRY=SK
SUPPLIER_ICO=53713486
SUPPLIER_DIC=
SUPPLIER_VAT_REGISTERED=false
SUPPLIER_VAT_ID=
SUPPLIER_REGISTRATION=Okresný súd Bratislava III, oddiel: Sro, vložka: 152437/B
SUPPLIER_BANK_NAME=Slovenská sporiteľňa, a.s.
SUPPLIER_IBAN=SK00 0900 0000 0000 0000 0000
SUPPLIER_BIC=GIBASKBX
SUPPLIER_EMAIL=hello@24design.sk
SUPPLIER_PHONE=+421940877997
SUPPLIER_LOGO_URL=

# === Invoice settings ===
# {year} and {seq:04d} placeholders. Default: 20260001
INVOICE_NUMBER_FORMAT={year}{seq:04d}
INVOICE_LANGUAGE=sk
VAT_RATE=20

# === Database ===
# SQLite default — for production, use postgresql://user:pass@host/db
DATABASE_URL=sqlite:////data/invoices.db

# === Storage ===
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/pdfs

# === Email — pick ONE of the two options below ===

# --- Option A: Brevo (recommended for SK customers, transactional API) ---
# BREVO_API_KEY=xkeysib-replace-me
# BREVO_SENDER_EMAIL=hello@yourcompany.sk
# BREVO_SENDER_NAME=Your Company

# --- Option B: SMTP (any provider — Brevo, Postmark, Gmail, etc.) ---
# SMTP_HOST=smtp.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=hello@yourcompany.sk
# SMTP_FROM_NAME=Your Company

# === Read API auth (optional) ===
# If set, GET endpoints require X-API-Key header
# READ_API_KEY=

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
