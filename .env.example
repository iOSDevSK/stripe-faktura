# ─────────────────────────────────────────────────────────────────────────
# stripe-faktura — vzorová konfigurácia
# Skopíruj do `.env` a doplň svoje hodnoty.
# ─────────────────────────────────────────────────────────────────────────

# === Stripe ===
STRIPE_API_KEY=sk_test_doplnit
STRIPE_WEBHOOK_SECRET=whsec_doplnit

# === Dodávateľ (tvoja firma — vystavovateľ faktúry) ===
SUPPLIER_NAME=BELNEM s.r.o.
SUPPLIER_STREET=Beckovská 5
SUPPLIER_CITY=Bratislava
SUPPLIER_ZIP=82104
SUPPLIER_COUNTRY=SK
SUPPLIER_ICO=53713486
SUPPLIER_DIC=
SUPPLIER_VAT_REGISTERED=false
SUPPLIER_VAT_ID=
SUPPLIER_REGISTRATION=Okresný súd Bratislava III, oddiel: Sro, vložka: 152437/B
SUPPLIER_BANK_NAME=
# Voliteľné — ak nie sú vyplnené IBAN/BIC/KS, v PDF sa nezobrazia
# (vhodné keď zákazník už zaplatil kartou a bankové údaje nie sú potrebné).
SUPPLIER_IBAN=
SUPPLIER_BIC=
SUPPLIER_KS=
SUPPLIER_EMAIL=hello@24design.sk
SUPPLIER_PHONE=+421940877997
# Voliteľné logo — externý URL alebo lokálny súbor v templates/.
# Ak ani jedno, použije sa textový fallback (názov firmy).
# Bundled vzor pre 24design.sk: SUPPLIER_LOGO_PATH=logo-24design.svg
SUPPLIER_LOGO_URL=
SUPPLIER_LOGO_PATH=

# === Bezpečnosť — POVINNÉ ===
# Vygeneruj silný náhodný kľúč:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Bez tohto kľúča sa app nespustí. Slúži na ochranu admin endpointov
# (GET /invoices a /invoices/{number}) — chráni PII a IČO/DIČ zákazníkov.
READ_API_KEY=

# Voliteľné: dedikovaný secret pre HMAC PDF tokeny.
# Ak prázdne, odvodí sa zo STRIPE_WEBHOOK_SECRET (postačujúce v 99 % prípadov).
PDF_TOKEN_SECRET=

# === POST /checkout endpoint — bezpečnostný allowlist ===
# Comma-separated zoznam origins ktorí smú volať /checkout (frontend domény).
# Bez tohto je /checkout endpoint vypnutý (403). Príklad:
ALLOWED_ORIGINS=https://24design.sk,https://24design.cz

# Comma-separated zoznam Stripe price_id ktoré sú povolené v /checkout.
# Bráni útočníkovi vytvoriť session pre 0 € fake produkt.
# Bez tohto je /checkout endpoint vypnutý (503). Príklad:
ALLOWED_PRICE_IDS=price_1TR5miQ1nUjRL12CV3uVek2D,price_1TR5mSQ1nUjRL12C1OgEUkYj

# === Verejná URL (pre linky v emailoch zákazníkom) ===
# Napr. https://faktura.24design.sk
# Ak prázdne, email obsahuje len PDF prílohu (bez backup linku).
BASE_URL=

# === Nastavenia faktúry ===
# Placeholdre {year} a {seq:04d}. Predvolené: 20260001
INVOICE_NUMBER_FORMAT={year}{seq:04d}
INVOICE_LANGUAGE=sk
VAT_RATE=20

# === Databáza ===
# Predvolene SQLite — pre produkciu použi postgresql://user:pass@host/db
DATABASE_URL=sqlite:////data/invoices.db

# === Úložisko ===
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/pdfs

# === Email — vyber JEDNU z dvoch možností nižšie ===

# --- Možnosť A: Brevo (odporúčané pre SK zákazníkov, transakčné API) ---
# BREVO_API_KEY=xkeysib-doplnit
# BREVO_SENDER_EMAIL=hello@tvojafirma.sk
# BREVO_SENDER_NAME=Tvoja firma

# --- Možnosť B: SMTP (akýkoľvek poskytovateľ — Brevo, Postmark, Gmail, ...) ---
# SMTP_HOST=smtp.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=hello@tvojafirma.sk
# SMTP_FROM_NAME=Tvoja firma

# --- Admin BCC kópie faktúr (voliteľné) ---
# Comma-separated zoznam emailov ktoré dostanú BCC kópiu každej
# zákazníckej faktúry (rovnaké PDF v prílohe). Užitočné pre vlastnú
# evidenciu bez nutnosti chodiť do DB. Prázdne = žiadna admin kópia.
# ADMIN_BCC_EMAILS=hello@tvojafirma.sk,majitel@gmail.com

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
